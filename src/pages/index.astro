---
import { getCollection } from "astro:content";
import FormattedDate from "../components/FormattedDate.astro";
import MainLayout from "../layouts/MainLayout.astro";

const posts = (
  await getCollection(
    "blog",
    ({ id }) => !id.startsWith("_") && !id.startsWith("drafts/"),
  )
)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<MainLayout>
  <style>
    /* General Section Styling */
    .section {
      padding: 5rem 2rem;
      max-width: 1200px;
      margin: 0 auto;
      text-align: center;
    }

    /* Hero Section */
    .hero {
      padding-top: 12rem;
      padding-bottom: 18rem;
      text-align: center; /* Center hero content */
      position: relative;
      overflow: hidden;
    }

    .hero-text {
      position: relative;
      z-index: 1;
    }
    .hero h1 {
      font-size: 3.2rem;
      font-weight: bold;
      margin-bottom: 1rem;
      line-height: 1.2;
    }

    .hero .subtitle {
      font-size: 1.5rem;
      color: var(--text-color-secondary);
      margin-bottom: 2rem;
    }

    .hero p {
      font-size: 1.1rem;
      margin: 0 auto 2rem auto; /* Center the paragraph */
      max-width: 50ch;
    }

    .cta-group {
      display: flex;
      gap: 1rem;
      justify-content: center; /* Center buttons */
    }

    .cta-button {
      display: inline-block;
      padding: 0.8rem 1.8rem;
      border-radius: 8px;
      text-decoration: none;
      font-weight: bold;
      transition:
        transform 0.2s ease-out,
        box-shadow 0.2s ease-out;
    }

    .cta-primary {
      background-color: var(--link-color);
      color: var(--bg-color);
    }

    .cta-secondary {
      background-color: transparent;
      color: var(--link-color);
      border: 1px solid var(--link-color);
    }

    .cta-button:hover {
      transform: translateY(-3px);
      box-shadow: 0 4px 12px rgba(var(--black), 0.15);
    }

    [data-theme="dark"] .cta-button:hover {
      box-shadow: 0 4px 12px rgba(var(--white), 0.15);
    }

    .featured-posts {
      width: 100%;
    }

    /* Skills Section */
    .section-title {
      text-align: left;
      font-size: 2.8rem;
      margin-bottom: 3rem;
    }

    .skills-grid {
      display: flex;
      flex-direction: column;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 2rem;
      text-align: left;
    }

    .skill-card {
      background-color: var(--bg-color-secondary);
      padding: 2rem;
      border-radius: 12px;
      border: 1px solid var(--border-color);
    }

    .skill-card h3 {
      font-size: 1.5rem;
      margin-bottom: 1rem;
      margin-top: 0rem;
    }

    .skill-card p {
      color: var(--text-color-secondary);
      margin-bottom: 1.5rem;
    }

    .tech-list {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .tech-tag {
      background-color: var(--bg-color);
      color: var(--link-color);
      padding: 0.25rem 0.75rem;
      border-radius: 15px;
      font-size: 0.8rem;
      border: 1px solid var(--border-color);
    }

    /* Featured Posts Section */
    .post-list {
      display: flex;
      flex-direction: column;
      width: 100%;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 2rem;
      list-style: none;
      padding: 0;
    }

    .post-item {
      background-color: var(--bg-color-secondary);
      border: 1px solid var(--border-color);
      border-radius: 12px;
      overflow: hidden;
      transition:
        transform 0.3s ease,
        box-shadow 0.3s ease;
      text-align: left;
      z-index: 1;
      position: relative;
    }

    .post-item:hover {
      transform: translateY(-5px);
      box-shadow: 0 8px 20px rgba(var(--black), 0.1);
    }

    [data-theme="dark"] .post-item:hover {
      box-shadow: 0 8px 20px rgba(var(--white), 0.1);
    }

    .post-item a {
      text-decoration: none;
      color: var(--text-color);
    }

    .post-item img {
      width: 100%;
      height: 200px;
      object-fit: cover;
    }

    .post-content {
      padding: 1.5rem;
    }

    .post-content h3 {
      font-size: 1.5rem;
      margin: 0 0 0.5rem 0;
    }

    .post-content h3 a {
      text-decoration: none;
      color: var(--text-color);
    }

    .post-content h3 a:hover {
      text-decoration: underline;
    }

    .post-content p {
      color: var(--text-color-secondary);
      font-size: 0.9rem;
    }
  </style>
  <section class="hero section">
    <div class="hero-text">
      <h1>Conor</h1>
      <p class="subtitle">Software Engineer</p>
      <div class="cta-group">
        <a href="/career" class="cta-button cta-secondary">My Career</a>
        <a href="/blog" class="cta-button cta-primary">Read My Blog</a>
      </div>
    </div>
  </section>

  <section class="skills section">
    <h2 class="section-title">What I've Done</h2>
    <div class="skills-grid">
      <div class="skill-card">
        <h3>Full-Stack Engineering</h3>
        <p>
          I've built robust and scalable web applications from front to back,
          focusing on clean architecture and great user experiences.
        </p>
        <div class="tech-list">
          <span class="tech-tag">React</span>
          <span class="tech-tag">Ruby on Rails</span>
          <span class="tech-tag">TypeScript</span>
          <span class="tech-tag">GraphQL</span>
          <span class="tech-tag">AWS</span>
        </div>
      </div>
      <div class="skill-card">
        <h3>AI & Machine Learning</h3>
        <p>
          I've developed AI-powered systems, from training neural networks for
          object detection to building data pipelines for ML models.
        </p>
        <div class="tech-list">
          <span class="tech-tag">Python</span>
          <span class="tech-tag">PyTorch</span>
          <span class="tech-tag">OpenCV</span>
          <span class="tech-tag">Pandas</span>
          <span class="tech-tag">YOLO</span>
        </div>
      </div>
      <div class="skill-card">
        <h3>Data Engineering</h3>
        <p>
          I've designed and built pipelines for processing and visualizing
          large-scale data, helping to surface crucial business insights.
        </p>
        <div class="tech-list">
          <span class="tech-tag">SQL</span>
          <span class="tech-tag">Azure Data Lake</span>
          <span class="tech-tag">Apache Airflow</span>
          <span class="tech-tag">Power BI</span>
        </div>
      </div>
    </div>
  </section>

  <section class="featured-posts section">
    <h2 class="section-title">Recent Blog Posts</h2>
    <ul class="post-list">
      {
        posts.map((post) => (
          <li class="post-item">
            {post.data.heroImage && (
              <a href={`/blog/${post.slug}/`}>
                <img src={post.data.heroImage} alt="" />
              </a>
            )}
            <div class="post-content">
              <h3>
                <a href={`/blog/${post.slug}/`}>{post.data.title}</a>
              </h3>
              <p>
                <FormattedDate date={post.data.pubDate} />
              </p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>
</MainLayout>
