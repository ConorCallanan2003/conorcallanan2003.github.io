---
import { getCollection } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';

const isDev = import.meta.env.DEV;

const posts = (await getCollection('blog', ({ id }) => {
	// Always exclude files starting with underscore
	if (id.startsWith('_')) return false;
	
	// In dev mode, include drafts; in production, exclude them
	if (id.startsWith('drafts/')) return isDev;
	
	return true;
})).sort(
	(a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf()
);
---

<MainLayout title="Blog">
  <style>
    .post-list {
      display: flex;
      flex-direction: column;
      width: 100%;
      gap: 2rem;
      list-style: none;
      padding: 0;
    }

    .post-item {
      background-color: var(--bg-color-secondary);
      border: 1px solid var(--border-color);
      border-radius: 12px;
      overflow: hidden;
      transition:
        transform 0.3s ease,
        box-shadow 0.3s ease;
      text-align: left;
      z-index: 1;
      position: relative;
    }

    .post-item:hover {
      transform: translateY(-5px);
      box-shadow: 0 8px 20px rgba(var(--black), 0.1);
    }

    [data-theme="dark"] .post-item:hover {
      box-shadow: 0 8px 20px rgba(var(--white), 0.1);
    }

    .post-item a {
      text-decoration: none;
      color: var(--text-color);
    }

    .post-item img {
      width: 100%;
      height: 200px;
      object-fit: cover;
    }

    .post-content {
      padding: 1.5rem;
    }

    .post-content h3 {
      font-size: 1.5rem;
      margin: 0 0 0.5rem 0;
    }

    .post-content h3 a {
      text-decoration: none;
      color: var(--text-color);
    }

    .post-content h3 a:hover {
      text-decoration: underline;
    }

    .post-content p {
      color: var(--text-color-secondary);
      font-size: 0.9rem;
    }
  </style>
	<section>
		<ul class="post-list">
			{
				posts.map((post) => (
					<li class="post-item">
            {post.data.heroImage && (
              <a href={`/blog/${post.slug}/`}>
                <img src={post.data.heroImage} alt="" />
              </a>
            )}
            <div class="post-content">
              <h3>
                <a href={`/blog/${post.slug}/`}>{post.data.title}</a>
              </h3>
              <p>
                <FormattedDate date={post.data.pubDate} />
              </p>
            </div>
					</li>
				))
			}
		</ul>
	</section>
</MainLayout>
